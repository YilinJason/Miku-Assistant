# ===== 全局参数（v1 基线，不做动态切换）=====

#模型回答随机性（创造性）和稳定性的参数
#pramtpe - float
#range - 0 - 1.0
#数字越高，创造性思维越强
PARAMETER temperature 0.65

#控制模型在生成下一个 token 时，允许从多大范围的候选词里进行选择
#pramtpe - float
#range - 0 - 1.0
PARAMETER top_p 0.90

# 过滤低概率离谱候选
PARAMETER min_p 0.05

#只允许概率最高的 K 个候选 token 参与下一步生成。
PARAMETER top_k 40

#惩罚模型重复已经说过的内容，减少复读、车轱辘话和死循环。
PARAMETER repeat_penalty 1.13

#repeat_penalty 的作用范围
PARAMETER repeat_last_n 128

#模型的短期记忆容量
PARAMETER num_ctx 8192

#限制模型一次最多生成多少个 token。也就是回答长度上限
PARAMETER num_predict 700


# 防止模型伪造下一轮用户输入
PARAMETER stop "User:"
PARAMETER stop "用户："
PARAMETER stop "Assistant:"
PARAMETER stop "助手："

